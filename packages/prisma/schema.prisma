  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitCost    Decimal @default(0) @db.Decimal(19, 4)
  totalCost   Decimal @default(0) @db.Decimal(19, 4)
  sequence    Int

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("work_order_costs")
}

model IoTDevice {
  id         String    @id @default(uuid())
  tenantId   String
  companyId  String
  assetId    String?
  code       String
  name       String
  protocol   String?
  status     String    @default("ACTIVE")
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  asset    Asset?       @relation(fields: [assetId], references: [id])
  readings IoTReading[]

  @@index([tenantId, companyId])
  @@map("iot_devices")
}

model IoTReading {
  id        String   @id @default(uuid())
  deviceId  String
  metric    String
  value     Decimal  @db.Decimal(19, 6)
  unit      String?
  isAlert   Boolean  @default(false)
  timestamp DateTime @default(now())

  device IoTDevice @relation(fields: [deviceId], references: [id])

  @@index([deviceId, timestamp])
  @@map("iot_readings")
}

// ==========================================
// FSM — FIELD SERVICE MANAGEMENT
// ==========================================

model Technician {
  id        String   @id @default(uuid())
  tenantId  String
  companyId String
  code      String
  name      String
  phone     String?
  email     String?
  skills    Json?
  status    String   @default("AVAILABLE")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceOrders ServiceOrder[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("technicians")
}

model ServiceContract {
  id         String   @id @default(uuid())
  tenantId   String
  companyId  String
  number     String
  name       String
  customerId String
  startDate  DateTime
  endDate    DateTime
  value      Decimal? @db.Decimal(19, 4)
  slaHours   Int?
  status     String   @default("ACTIVE")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id])
  serviceOrders ServiceOrder[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("service_contracts")
}

model ServiceOrder {
  id             String    @id @default(uuid())
  tenantId       String
  companyId      String
  number         String
  type           String    @default("REPAIR")
  priority       String    @default("NORMAL")
  customerId     String?
  contractId     String?
  technicianId   String?
  description    String
  status         String    @default("OPEN")
  scheduledAt    DateTime?
  slaDeadline    DateTime?
  arrivedAt      DateTime?
  completedAt    DateTime?
  resolution     String?
  customerRating Int?
  reportedAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer   Customer?        @relation(fields: [customerId], references: [id])
  contract   ServiceContract? @relation(fields: [contractId], references: [id])
  technician Technician?      @relation(fields: [technicianId], references: [id])
  notes      ServiceOrderNote[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("service_orders")
}

model ServiceOrderNote {
  id             String   @id @default(uuid())
  serviceOrderId String
  authorId       String
  content        String
  isInternal     Boolean  @default(false)
  createdAt      DateTime @default(now())

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@map("service_order_notes")
}

// ==========================================
// QUALITY
// ==========================================

model InspectionTemplate {
  id          String  @id @default(uuid())
  tenantId    String
  companyId   String
  name        String
  category    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       InspectionTemplateItem[]
  inspections Inspection[]

  @@index([tenantId, companyId])
  @@map("inspection_templates")
}

model InspectionTemplateItem {
  id          String  @id @default(uuid())
  templateId  String
  sequence    Int
  question    String
  itemType    String  @default("PASS_FAIL")
  options     Json?
  isRequired  Boolean @default(true)

  template    InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  responses   InspectionResponse[]

  @@map("inspection_template_items")
}

model Inspection {
  id            String    @id @default(uuid())
  tenantId      String
  companyId     String
  templateId    String
  reference     String?
  scheduledAt   DateTime?
  conductedAt   DateTime?
  conductedBy   String?
  status        String    @default("SCHEDULED")
  findings      String?
  overallResult String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  template  InspectionTemplate   @relation(fields: [templateId], references: [id])
  responses InspectionResponse[]
  ncrs      NonConformance[]

  @@index([tenantId, companyId])
  @@map("inspections")
}

model InspectionResponse {
  id           String   @id @default(uuid())
  inspectionId String
  itemId       String
  result       String?
  numericValue Decimal? @db.Decimal(19, 4)
  textValue    String?
  notes        String?
  hasDefect    Boolean  @default(false)

  inspection Inspection             @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  item       InspectionTemplateItem @relation(fields: [itemId], references: [id])

  @@map("inspection_responses")
}

model NonConformance {
  id           String    @id @default(uuid())
  tenantId     String
  companyId    String
  number       String
  inspectionId String?
  title        String
  description  String
  severity     String    @default("MINOR")
  source       String?
  raisedBy     String
  raisedAt     DateTime  @default(now())
  dueDate      DateTime?
  status       String    @default("OPEN")
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  inspection Inspection? @relation(fields: [inspectionId], references: [id])
  actions    NCRAction[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("non_conformances")
}

model NCRAction {
  id          String    @id @default(uuid())
  ncrId       String
  actionType  String
  description String
  assignedTo  String
  dueDate     DateTime?
  status      String    @default("OPEN")
  completedAt DateTime?

  ncr NonConformance @relation(fields: [ncrId], references: [id], onDelete: Cascade)

  @@map("ncr_actions")
}

model Audit {
  id             String    @id @default(uuid())
  tenantId       String
  companyId      String
  auditType      String
  reference      String
  title          String
  scope          String?
  auditor        String
  scheduledStart DateTime
  scheduledEnd   DateTime
  actualStart    DateTime?
  actualEnd      DateTime?
  status         String    @default("PLANNED")
  findings       String?
  result         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  findings_ AuditFinding[]

  @@index([tenantId, companyId])
  @@map("audits")
}

model AuditFinding {
  id             String  @id @default(uuid())
  auditId        String
  findingType    String
  description    String
  clause         String?
  requiresAction Boolean @default(false)

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@map("audit_findings")
}

// ==========================================
// EHS — ENVIRONMENT, HEALTH & SAFETY
// ==========================================

model Incident {
  id                 String    @id @default(uuid())
  tenantId           String
  companyId          String
  number             String
  incidentType       String
  severity           String    @default("LOW")
  title              String
  description        String
  occurredAt         DateTime
  location           String?
  reportedBy         String?
  status             String    @default("OPEN")
  rootCause          String?
  preventiveActions  String?
  closedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("incidents")
}

model RiskAssessment {
  id          String   @id @default(uuid())
  tenantId    String
  companyId   String
  reference   String
  title       String
  scope       String?
  assessedBy  String
  assessedAt  DateTime @default(now())
  reviewDue   DateTime
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hazards RiskHazard[]

  @@index([tenantId, companyId])
  @@map("risk_assessments")
}

model RiskHazard {
  id                  String  @id @default(uuid())
  assessmentId        String
  hazard              String
  category            String  @default("GENERAL")
  likelihood          Int
  severity            Int
  riskScore           Int
  controls            String?
  residualLikelihood  Int?
  residualSeverity    Int?
  residualScore       Int?

  assessment RiskAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("risk_hazards")
}

model PermitToWork {
  id          String   @id @default(uuid())
  tenantId    String
  companyId   String
  number      String
  permitType  String
  title       String
  description String?
  requestedBy String
  location    String?
  validFrom   DateTime
  validTo     DateTime
  status      String   @default("PENDING")
  approvedBy  String?
  closedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("permits_to_work")
}

// ==========================================
// PROJECTS
// ==========================================

model Project {
  id          String    @id @default(uuid())
  tenantId    String
  companyId   String
  code        String
  name        String
  description String?
  customerId  String?
  managerId   String?
  status      String    @default("PLANNING")
  startDate   DateTime
  endDate     DateTime?
  budget      Decimal?  @db.Decimal(19, 4)
  actualCost  Decimal   @default(0) @db.Decimal(19, 4)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks      WBSTask[]
  timesheets Timesheet[]
  billings   ProjectBilling[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("projects")
}

model WBSTask {
  id             String    @id @default(uuid())
  tenantId       String
  companyId      String
  projectId      String
  parentId       String?
  code           String
  title          String
  description    String?
  assigneeId     String?
  status         String    @default("TODO")
  priority       String    @default("NORMAL")
  estimatedHours Decimal?  @db.Decimal(10, 2)
  actualHours    Decimal   @default(0) @db.Decimal(10, 2)
  progress       Int       @default(0)
  plannedStart   DateTime?
  plannedEnd     DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project    Project    @relation(fields: [projectId], references: [id])
  parent     WBSTask?   @relation("WBSTaskHierarchy", fields: [parentId], references: [id])
  children   WBSTask[]  @relation("WBSTaskHierarchy")
  timesheets Timesheet[]

  @@index([tenantId, companyId, projectId])
  @@map("wbs_tasks")
}

model Timesheet {
  id         String   @id @default(uuid())
  tenantId   String
  companyId  String
  projectId  String
  taskId     String?
  employeeId String?
  date       DateTime
  hours      Decimal  @db.Decimal(10, 2)
  billable   Boolean  @default(true)
  description String?
  status     String   @default("DRAFT")
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project  @relation(fields: [projectId], references: [id])
  task    WBSTask? @relation(fields: [taskId], references: [id])

  @@index([tenantId, companyId, projectId])
  @@map("timesheets")
}

model ProjectBilling {
  id          String    @id @default(uuid())
  tenantId    String
  companyId   String
  projectId   String
  description String
  amount      Decimal   @db.Decimal(19, 4)
  billingDate DateTime?
  status      String    @default("PENDING")
  billedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@index([tenantId, companyId, projectId])
  @@map("project_billings")
}
