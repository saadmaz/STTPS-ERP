generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// PLATFORM — tenant registry
// ==========================================

model Tenant {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  plan       String   @default("starter")
  status     String   @default("active")
  settings   Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  companies  Company[]
  users      User[]

  @@map("tenants")
}

// ==========================================
// IDENTITY & ACCESS
// ==========================================

model Company {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  code            String
  legalName       String?
  taxId           String?
  currency        String    @default("USD")
  timezone        String    @default("UTC")
  fiscalYearStart Int       @default(1)
  address         Json?
  logoUrl         String?
  parentId        String?
  parent          Company?  @relation("CompanyHierarchy", fields: [parentId], references: [id])
  children        Company[] @relation("CompanyHierarchy")
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  companyUsers    CompanyUser[]
  roles           Role[]
  glAccounts      GlAccount[]
  glPeriods       GlPeriod[]
  glJournals      GlJournal[]
  vendors         Vendor[]
  customers       Customer[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("companies")
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  firstName    String
  lastName     String
  passwordHash String
  phone        String?
  avatar       String?
  isActive        Boolean   @default(true)
  isSuperAdmin    Boolean   @default(false)
  isPlatformAdmin Boolean   @default(false)
  mfaEnabled      Boolean   @default(false)
  mfaSecret    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  companyUsers CompanyUser[]
  sessions     Session[]
  auditLogs    AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model CompanyUser {
  id        String  @id @default(uuid())
  userId    String
  companyId String
  isDefault Boolean @default(false)

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([userId, companyId])
  @@map("company_users")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  companyId   String?
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company         Company?         @relation(fields: [companyId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([tenantId])
  @@map("roles")
}

model UserRole {
  id            String      @id @default(uuid())
  companyUserId String
  roleId        String
  grantedAt     DateTime    @default(now())
  grantedBy     String?

  companyUser CompanyUser @relation(fields: [companyUserId], references: [id], onDelete: Cascade)
  role        Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([companyUserId, roleId])
  @@map("user_roles")
}

model Permission {
  id     String @id @default(uuid())
  code   String @unique
  name   String
  module String
  action String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  companyId String?
  userId    String?
  module    String
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ==========================================
// FINANCE — GENERAL LEDGER
// ==========================================

model GlAccount {
  id          String  @id @default(uuid())
  tenantId    String
  companyId   String
  code        String
  name        String
  type        String
  subtype     String?
  currency    String  @default("USD")
  parentId    String?
  isActive    Boolean @default(true)
  isPosting   Boolean @default(true)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company   @relation(fields: [companyId], references: [id])
  parent       GlAccount?  @relation("GlAccountTree", fields: [parentId], references: [id])
  children     GlAccount[] @relation("GlAccountTree")
  journalLines GlJournalLine[]
  apLines      ApInvoiceLine[]
  arLines      ArInvoiceLine[]
  bankAccounts BankAccount[]
  budgetLines  BudgetLine[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("gl_accounts")
}

model GlPeriod {
  id         String   @id @default(uuid())
  tenantId   String
  companyId  String
  fiscalYear Int
  period     Int
  name       String
  startDate  DateTime
  endDate    DateTime
  status     String   @default("OPEN")

  company  Company     @relation(fields: [companyId], references: [id])
  journals GlJournal[]

  @@unique([tenantId, companyId, fiscalYear, period])
  @@index([tenantId, companyId])
  @@map("gl_periods")
}

model GlJournal {
  id          String    @id @default(uuid())
  tenantId    String
  companyId   String
  periodId    String
  number      String
  date        DateTime
  description String?
  reference   String?
  type        String    @default("MANUAL")
  status      String    @default("DRAFT")
  currency    String    @default("USD")
  totalDebit  Decimal   @default(0) @db.Decimal(19, 4)
  totalCredit Decimal   @default(0) @db.Decimal(19, 4)
  createdBy   String
  postedBy    String?
  postedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company       @relation(fields: [companyId], references: [id])
  period  GlPeriod      @relation(fields: [periodId], references: [id])
  lines   GlJournalLine[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId, date])
  @@map("gl_journals")
}

model GlJournalLine {
  id           String  @id @default(uuid())
  journalId    String
  accountId    String
  lineNumber   Int
  description  String?
  debit        Decimal @default(0) @db.Decimal(19, 4)
  credit       Decimal @default(0) @db.Decimal(19, 4)
  currency     String  @default("USD")
  exchangeRate Decimal @default(1) @db.Decimal(19, 6)

  journal GlJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account GlAccount @relation(fields: [accountId], references: [id])

  @@map("gl_journal_lines")
}

// ==========================================
// FINANCE — FIXED ASSETS
// ==========================================

model FixedAsset {
  id                  String    @id @default(uuid())
  tenantId            String
  companyId           String
  code                String
  name                String
  category            String
  acquisitionDate     DateTime
  acquisitionCost     Decimal   @default(0) @db.Decimal(19, 4)
  salvageValue        Decimal   @default(0) @db.Decimal(19, 4)
  netBookValue        Decimal   @default(0) @db.Decimal(19, 4)
  accumulatedDepr     Decimal   @default(0) @db.Decimal(19, 4)
  depreciationMethod  String    @default("STRAIGHT_LINE")
  usefulLifeMonths    Int       @default(60)
  assetAccountId      String?
  depreciationAcctId  String?
  accumDeprAcctId     String?
  notes               String?
  status              String    @default("ACTIVE")
  disposalDate        DateTime?
  disposalAmount      Decimal?  @db.Decimal(19, 4)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("fixed_assets")
}

// ==========================================
// FINANCE — BANK
// ==========================================

model BankAccount {
  id            String   @id @default(uuid())
  tenantId      String
  companyId     String
  code          String
  name          String
  bankName      String?
  accountNumber String?
  currency      String   @default("USD")
  balance       Decimal  @default(0) @db.Decimal(19, 4)
  glAccountId   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  glAccount  GlAccount?      @relation(fields: [glAccountId], references: [id])
  statements BankStatement[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("bank_accounts")
}

model BankStatement {
  id            String   @id @default(uuid())
  tenantId      String
  companyId     String
  bankAccountId String
  date          DateTime
  description   String?
  reference     String?
  debit         Decimal  @default(0) @db.Decimal(19, 4)
  credit        Decimal  @default(0) @db.Decimal(19, 4)
  balance       Decimal  @default(0) @db.Decimal(19, 4)
  isReconciled  Boolean  @default(false)
  createdAt     DateTime @default(now())

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  @@index([bankAccountId])
  @@map("bank_statements")
}

// ==========================================
// FINANCE — BUDGET
// ==========================================

model Budget {
  id          String    @id @default(uuid())
  tenantId    String
  companyId   String
  name        String
  fiscalYear  Int
  description String?
  status      String    @default("DRAFT")
  createdBy   String
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lines BudgetLine[]

  @@index([tenantId, companyId])
  @@map("budgets")
}

model BudgetLine {
  id        String  @id @default(uuid())
  budgetId  String
  accountId String
  period    Int
  amount    Decimal @default(0) @db.Decimal(19, 4)
  notes     String?

  budget  Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account GlAccount @relation(fields: [accountId], references: [id])

  @@map("budget_lines")
}

// ==========================================
// ACCOUNTS PAYABLE
// ==========================================

model Vendor {
  id           String   @id @default(uuid())
  tenantId     String
  companyId    String
  code         String
  name         String
  legalName    String?
  taxId        String?
  email        String?
  phone        String?
  currency     String   @default("USD")
  paymentTerms Int      @default(30)
  address      Json?
  bankDetails  Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company        Company        @relation(fields: [companyId], references: [id])
  invoices       ApInvoice[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("vendors")
}

model ApInvoice {
  id            String    @id @default(uuid())
  tenantId      String
  companyId     String
  vendorId      String
  poId          String?
  number        String
  vendorRef     String?
  date          DateTime
  dueDate       DateTime
  currency      String    @default("USD")
  exchangeRate  Decimal   @default(1) @db.Decimal(19, 6)
  subtotal      Decimal   @default(0) @db.Decimal(19, 4)
  taxAmount     Decimal   @default(0) @db.Decimal(19, 4)
  total         Decimal   @default(0) @db.Decimal(19, 4)
  paid          Decimal   @default(0) @db.Decimal(19, 4)
  balance       Decimal   @default(0) @db.Decimal(19, 4)
  status        String    @default("DRAFT")
  notes         String?
  createdBy     String
  approvedBy    String?
  approvedAt    DateTime?
  postedBy      String?
  postedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vendor         Vendor          @relation(fields: [vendorId], references: [id])
  po             PurchaseOrder?  @relation(fields: [poId], references: [id])
  lines          ApInvoiceLine[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("ap_invoices")
}

model ApInvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  accountId   String
  lineNumber  Int
  description String
  quantity    Decimal @default(1) @db.Decimal(19, 4)
  unitPrice   Decimal @default(0) @db.Decimal(19, 4)
  amount      Decimal @default(0) @db.Decimal(19, 4)
  taxCode     String?
  taxAmount   Decimal @default(0) @db.Decimal(19, 4)

  invoice ApInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  account GlAccount @relation(fields: [accountId], references: [id])

  @@map("ap_invoice_lines")
}

// ==========================================
// ACCOUNTS RECEIVABLE
// ==========================================

model Customer {
  id           String   @id @default(uuid())
  tenantId     String
  companyId    String
  code         String
  name         String
  legalName    String?
  taxId        String?
  email        String?
  phone        String?
  currency     String   @default("USD")
  paymentTerms Int      @default(30)
  creditLimit  Decimal  @default(0) @db.Decimal(19, 4)
  address      Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company          Company          @relation(fields: [companyId], references: [id])
  invoices         ArInvoice[]
  salesQuotes      SalesQuote[]
  salesOrders      SalesOrder[]
  serviceContracts ServiceContract[]
  serviceOrders    ServiceOrder[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("customers")
}

model ArInvoice {
  id           String    @id @default(uuid())
  tenantId     String
  companyId    String
  customerId   String
  number       String
  date         DateTime
  dueDate      DateTime
  currency     String    @default("USD")
  exchangeRate Decimal   @default(1) @db.Decimal(19, 6)
  subtotal     Decimal   @default(0) @db.Decimal(19, 4)
  taxAmount    Decimal   @default(0) @db.Decimal(19, 4)
  total        Decimal   @default(0) @db.Decimal(19, 4)
  paid         Decimal   @default(0) @db.Decimal(19, 4)
  balance      Decimal   @default(0) @db.Decimal(19, 4)
  status       String    @default("DRAFT")
  notes        String?
  createdBy    String
  postedBy     String?
  postedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id])
  lines    ArInvoiceLine[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("ar_invoices")
}

model ArInvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  accountId   String
  lineNumber  Int
  description String
  quantity    Decimal @default(1) @db.Decimal(19, 4)
  unitPrice   Decimal @default(0) @db.Decimal(19, 4)
  amount      Decimal @default(0) @db.Decimal(19, 4)
  taxCode     String?
  taxAmount   Decimal @default(0) @db.Decimal(19, 4)

  invoice ArInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  account GlAccount @relation(fields: [accountId], references: [id])

  @@map("ar_invoice_lines")
}

// ==========================================
// INVENTORY
// ==========================================

model ItemCategory {
  id          String  @id @default(uuid())
  tenantId    String
  companyId   String
  code        String?
  name        String
  description String?
  isActive    Boolean @default(true)

  items Item[]

  @@index([tenantId, companyId])
  @@map("item_categories")
}

model Item {
  id            String   @id @default(uuid())
  tenantId      String
  companyId     String
  code          String
  name          String
  description   String?
  categoryId    String?
  uom           String   @default("EA")
  type          String   @default("PRODUCT")
  isActive      Boolean  @default(true)
  standardCost  Decimal  @default(0) @db.Decimal(19, 4)
  salePrice     Decimal  @default(0) @db.Decimal(19, 4)
  purchasePrice Decimal  @default(0) @db.Decimal(19, 4)
  minStock      Decimal  @default(0) @db.Decimal(19, 4)
  maxStock      Decimal  @default(0) @db.Decimal(19, 4)
  reorderPoint  Decimal  @default(0) @db.Decimal(19, 4)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category             ItemCategory?         @relation(fields: [categoryId], references: [id])
  stockLevels          StockLevel[]
  stockMovements       StockMovement[]
  stockCountLines      StockCountLine[]
  bomLines             BOMLine[]
  boms                 BillOfMaterials[]
  productionOrders     ProductionOrder[]
  productionComponents ProductionComponent[]
  mrpProposals         MRPProposal[]
  priceListItems       PriceListItem[]
  quoteLines           SalesQuoteLine[]
  soLines              SOLine[]
  deliveryLines        DeliveryLine[]
  poLines              POLine[]
  prLines              PRLine[]
  grnLines             GRNLine[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("items")
}

model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String
  companyId String
  code      String
  name      String
  type      String?
  isActive  Boolean  @default(true)
  address   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations      StorageLocation[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  stockCounts    StockCount[]
  goodsReceipts  GoodsReceipt[]
  deliveries     Delivery[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("warehouses")
}

model StorageLocation {
  id          String  @id @default(uuid())
  warehouseId String
  code        String
  name        String
  description String?

  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  stockLevels StockLevel[]

  @@map("storage_locations")
}

model StockLevel {
  id          String  @id @default(uuid())
  tenantId    String
  companyId   String
  itemId      String
  warehouseId String
  locationId  String?
  qty         Decimal @default(0) @db.Decimal(19, 4)
  avgCost     Decimal @default(0) @db.Decimal(19, 4)

  item      Item             @relation(fields: [itemId], references: [id])
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  location  StorageLocation? @relation(fields: [locationId], references: [id])

  @@unique([tenantId, companyId, itemId, warehouseId])
  @@index([tenantId, companyId])
  @@map("stock_levels")
}

model StockMovement {
  id           String   @id @default(uuid())
  tenantId     String
  companyId    String
  itemId       String
  warehouseId  String
  movementType String
  reference    String?
  qty          Decimal  @db.Decimal(19, 4)
  unitCost     Decimal  @default(0) @db.Decimal(19, 4)
  totalCost    Decimal  @default(0) @db.Decimal(19, 4)
  qtyBefore    Decimal  @default(0) @db.Decimal(19, 4)
  qtyAfter     Decimal  @default(0) @db.Decimal(19, 4)
  notes        String?
  createdBy    String
  createdAt    DateTime @default(now())

  item      Item      @relation(fields: [itemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, companyId, itemId])
  @@map("stock_movements")
}

model StockCount {
  id          String    @id @default(uuid())
  tenantId    String
  companyId   String
  warehouseId String
  reference   String
  countDate   DateTime
  notes       String?
  status      String    @default("DRAFT")
  createdBy   String
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  lines     StockCountLine[]

  @@index([tenantId, companyId])
  @@map("stock_counts")
}

model StockCountLine {
  id           String  @id @default(uuid())
  stockCountId String
  itemId       String
  systemQty    Decimal @default(0) @db.Decimal(19, 4)
  countedQty   Decimal @default(0) @db.Decimal(19, 4)
  variance     Decimal @default(0) @db.Decimal(19, 4)
  notes        String?

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  item       Item       @relation(fields: [itemId], references: [id])

  @@map("stock_count_lines")
}

// ==========================================
// PROCUREMENT
// ==========================================

model PurchaseRequisition {
  id           String    @id @default(uuid())
  tenantId     String
  companyId    String
  number       String
  requestDate  DateTime
  requiredDate DateTime?
  status       String    @default("DRAFT")
  requestedBy  String
  approvedBy   String?
  approvedAt   DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines          PRLine[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("purchase_requisitions")
}

model PRLine {
  id         String  @id @default(uuid())
  prId       String
  itemId     String?
  lineNumber Int
  description String
  qty        Decimal @db.Decimal(19, 4)
  uom        String  @default("EA")
  estUnitCost Decimal @default(0) @db.Decimal(19, 4)
  estTotal   Decimal @default(0) @db.Decimal(19, 4)

  pr   PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
  item Item?               @relation(fields: [itemId], references: [id])

  @@map("pr_lines")
}

model PurchaseOrder {
  id           String    @id @default(uuid())
  tenantId     String
  companyId    String
  vendorId     String
  prId         String?
  number       String
  orderDate    DateTime
  expectedDate DateTime?
  currency     String    @default("USD")
  subtotal     Decimal   @default(0) @db.Decimal(19, 4)
  taxAmount    Decimal   @default(0) @db.Decimal(19, 4)
  total        Decimal   @default(0) @db.Decimal(19, 4)
  status       String    @default("DRAFT")
  notes        String?
  createdBy    String
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vendor        Vendor               @relation(fields: [vendorId], references: [id])
  pr            PurchaseRequisition? @relation(fields: [prId], references: [id])
  lines         POLine[]
  goodsReceipts GoodsReceipt[]
  apInvoices    ApInvoice[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("purchase_orders")
}

model POLine {
  id          String  @id @default(uuid())
  poId        String
  itemId      String?
  lineNumber  Int
  description String?
  qty         Decimal @db.Decimal(19, 4)
  uom         String  @default("EA")
  unitPrice   Decimal @default(0) @db.Decimal(19, 4)
  taxCode     String?
  lineTotal   Decimal @default(0) @db.Decimal(19, 4)
  qtyReceived Decimal @default(0) @db.Decimal(19, 4)

  po   PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  item Item?         @relation(fields: [itemId], references: [id])

  @@map("po_lines")
}

model GoodsReceipt {
  id          String    @id @default(uuid())
  tenantId    String
  companyId   String
  poId        String
  warehouseId String
  number      String
  receiptDate DateTime
  status      String    @default("DRAFT")
  notes       String?
  createdBy   String
  postedBy    String?
  postedAt    DateTime?
  createdAt   DateTime  @default(now())
