rules_version = '2';

// Only api/'s Firebase Admin SDK ever talks to Firestore — the Admin SDK
// bypasses these rules entirely (it authenticates as a service account, not
// a client). This deny-all is a safety net against anyone ever adding a
// client-side Firestore SDK call by mistake, not the real access control
// layer (that's JwtAuthGuard/RequirePermissionGuard in the API).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
