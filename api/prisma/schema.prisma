  @@map("job_applications")
}

// ==========================================
// PHASE 6 — EAM, FSM & IOT
// ==========================================

model AssetCategory {
  id          String   @id @default(uuid())
  tenantId    String
  companyId   String
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  assets  Asset[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("asset_categories")
}

model Asset {
  id                String    @id @default(uuid())
  tenantId          String
  companyId         String
  categoryId        String?
  parentId          String?
  code              String
  name              String
  description       String?
  serialNumber      String?
  model             String?
  manufacturer      String?
  location          String?
  status            String    @default("ACTIVE")
  purchaseDate      DateTime?
  purchaseCost      Decimal?  @db.Decimal(19, 4)
  warrantyExpiry    DateTime?
  lastMaintenanceAt DateTime?
  nextMaintenanceAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company          Company           @relation(fields: [companyId], references: [id])
  category         AssetCategory?    @relation(fields: [categoryId], references: [id])
  parent           Asset?            @relation("AssetHierarchy", fields: [parentId], references: [id])
  children         Asset[]           @relation("AssetHierarchy")
  maintenancePlans MaintenancePlan[]
  workOrders       WorkOrder[]
  iotDevices       IoTDevice[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("assets")
}

model MaintenancePlan {
  id             String    @id @default(uuid())
  tenantId       String
  companyId      String
  assetId        String
  code           String
  name           String
  description    String?
  planType       String    @default("PREVENTIVE")
  frequency      String    @default("MONTHLY")
  frequencyDays  Int       @default(30)
  lastRunAt      DateTime?
  nextDueAt      DateTime
  isActive       Boolean   @default(true)
  estimatedHours Decimal?  @db.Decimal(5, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company    Company               @relation(fields: [companyId], references: [id])
  asset      Asset                 @relation(fields: [assetId], references: [id])
  tasks      MaintenancePlanTask[]
  workOrders WorkOrder[]

  @@unique([tenantId, companyId, assetId, code])
  @@index([tenantId, companyId])
  @@map("maintenance_plans")
}

model MaintenancePlanTask {
  id            String @id @default(uuid())
  planId        String
  sequence      Int
  description   String
  estimatedMins Int    @default(0)

  plan MaintenancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("maintenance_plan_tasks")
}

model WorkOrder {
  id                String    @id @default(uuid())
  tenantId          String
  companyId         String
  assetId           String
  maintenancePlanId String?
  number            String
  type              String    @default("CORRECTIVE")
  priority          String    @default("NORMAL")
  status            String    @default("OPEN")
  description       String
  failureCode       String?
  resolution        String?
  assignedTo        String?
  reportedBy        String?
  reportedAt        DateTime  @default(now())
  scheduledStart    DateTime?
  scheduledEnd      DateTime?
  actualStart       DateTime?
  actualEnd         DateTime?
  estimatedHours    Decimal?  @db.Decimal(5, 2)
  actualHours       Decimal?  @db.Decimal(5, 2)
  totalCost         Decimal   @default(0) @db.Decimal(19, 4)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  asset           Asset            @relation(fields: [assetId], references: [id])
  maintenancePlan MaintenancePlan? @relation(fields: [maintenancePlanId], references: [id])
  costs           WorkOrderCost[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("work_orders")
}

model WorkOrderCost {
  id          String  @id @default(uuid())
  workOrderId String
  type        String
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 3)
  unitCost    Decimal @db.Decimal(19, 4)
  totalCost   Decimal @db.Decimal(19, 4)
  sequence    Int

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("work_order_costs")
}

model Technician {
  id         String   @id @default(uuid())
  tenantId   String
  companyId  String
  employeeId String?
  code       String
  name       String
  email      String
  phone      String?
  skills     String[]
  status     String   @default("AVAILABLE")
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company       Company        @relation(fields: [companyId], references: [id])
  serviceOrders ServiceOrder[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("technicians")
}

model ServiceContract {
  id           String   @id @default(uuid())
  tenantId     String
  companyId    String
  customerId   String
  number       String
  name         String
  description  String?
  contractType String   @default("TIME_AND_MATERIAL")
  status       String   @default("ACTIVE")
  startDate    DateTime
  endDate      DateTime
  value        Decimal? @db.Decimal(19, 4)
  slaHours     Int?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company       Company        @relation(fields: [companyId], references: [id])
  customer      Customer       @relation(fields: [customerId], references: [id])
  serviceOrders ServiceOrder[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("service_contracts")
}

model ServiceOrder {
  id             String    @id @default(uuid())
  tenantId       String
  companyId      String
  contractId     String?
  customerId     String?
  technicianId   String?
  number         String
  title          String
  description    String
  priority       String    @default("NORMAL")
  status         String    @default("OPEN")
  type           String    @default("REPAIR")
  location       String?
  contactName    String?
  contactPhone   String?
  reportedAt     DateTime  @default(now())
  scheduledAt    DateTime?
  arrivedAt      DateTime?
  completedAt    DateTime?
  slaDeadline    DateTime?
  resolution     String?
  customerRating Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company    Company            @relation(fields: [companyId], references: [id])
  customer   Customer?          @relation(fields: [customerId], references: [id])
  contract   ServiceContract?   @relation(fields: [contractId], references: [id])
  technician Technician?        @relation(fields: [technicianId], references: [id])
  notes      ServiceOrderNote[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("service_orders")
}

model ServiceOrderNote {
  id             String   @id @default(uuid())
  serviceOrderId String
  authorId       String
  content        String
  isInternal     Boolean  @default(false)
  createdAt      DateTime @default(now())

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@map("service_order_notes")
}

model IoTDevice {
  id         String    @id @default(uuid())
  tenantId   String
  companyId  String
  assetId    String?
  deviceId   String
  name       String
  type       String    @default("SENSOR")
  protocol   String    @default("REST")
  status     String    @default("ACTIVE")
  lastSeenAt DateTime?
  metadata   Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company  Company      @relation(fields: [companyId], references: [id])
  asset    Asset?       @relation(fields: [assetId], references: [id])
  readings IoTReading[]

  @@unique([tenantId, deviceId])
  @@index([tenantId, companyId])
  @@map("iot_devices")
}

model IoTReading {
  id        String   @id @default(uuid())
  deviceId  String
  metric    String
  value     Decimal  @db.Decimal(15, 6)
  unit      String?
  timestamp DateTime @default(now())
  isAlert   Boolean  @default(false)

  device IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, timestamp])
  @@map("iot_readings")
}

// ==========================================
// QUALITY MANAGEMENT
// ==========================================

model InspectionTemplate {
  id          String   @id @default(uuid())
  tenantId    String
  companyId   String
  code        String
  name        String
  category    String   @default("GENERAL")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company                  @relation(fields: [companyId], references: [id])
  items       InspectionTemplateItem[]
  inspections Inspection[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("inspection_templates")
}

model InspectionTemplateItem {
  id         String  @id @default(uuid())
  templateId String
  sequence   Int
  question   String
  itemType   String  @default("PASS_FAIL")
  options    Json?
  isRequired Boolean @default(true)

  template  InspectionTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  responses InspectionResponse[]

  @@map("inspection_template_items")
}

model Inspection {
  id            String    @id @default(uuid())
  tenantId      String
  companyId     String
  templateId    String
  number        String
  title         String
  status        String    @default("SCHEDULED")
  referenceType String?
  referenceId   String?
  scheduledAt   DateTime?
  conductedAt   DateTime?
  conductedBy   String?
  findings      String?
  overallResult String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company   Company              @relation(fields: [companyId], references: [id])
  template  InspectionTemplate   @relation(fields: [templateId], references: [id])
  responses InspectionResponse[]
  ncrs      NonConformance[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("inspections")
}

model InspectionResponse {
  id           String   @id @default(uuid())
  inspectionId String
  itemId       String
  result       String?
  numericValue Decimal? @db.Decimal(15, 4)
  textValue    String?
  notes        String?
  hasDefect    Boolean  @default(false)

  inspection Inspection             @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  item       InspectionTemplateItem @relation(fields: [itemId], references: [id])

  @@map("inspection_responses")
}

model NonConformance {
  id           String    @id @default(uuid())
  tenantId     String
  companyId    String
  number       String
  title        String
  description  String
  source       String    @default("INTERNAL")
  severity     String    @default("MEDIUM")
  status       String    @default("OPEN")
  raisedBy     String
  raisedAt     DateTime  @default(now())
  dueDate      DateTime?
  closedAt     DateTime?
  inspectionId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company    Company     @relation(fields: [companyId], references: [id])
  inspection Inspection? @relation(fields: [inspectionId], references: [id])
  actions    NCRAction[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("non_conformances")
}

model NCRAction {
  id          String    @id @default(uuid())
  ncrId       String
  actionType  String    @default("CORRECTIVE")
  description String
  assignedTo  String
  dueDate     DateTime?
  completedAt DateTime?
  status      String    @default("OPEN")

  ncr NonConformance @relation(fields: [ncrId], references: [id], onDelete: Cascade)

  @@map("ncr_actions")
}

model Audit {
  id             String    @id @default(uuid())
  tenantId       String
  companyId      String
  number         String
  title          String
  auditType      String    @default("INTERNAL")
  standard       String?
  scope          String?
  leadAuditor    String
  status         String    @default("PLANNED")
  scheduledStart DateTime
  scheduledEnd   DateTime
  actualStart    DateTime?
  actualEnd      DateTime?
  findings       String?
  result         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company   Company        @relation(fields: [companyId], references: [id])
  findings_ AuditFinding[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("audits")
}

model AuditFinding {
  id             String  @id @default(uuid())
  auditId        String
  findingType    String  @default("OBSERVATION")
  description    String
  clause         String?
  requiresAction Boolean @default(false)

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@map("audit_findings")
}

// ==========================================
// EHS — Environment, Health & Safety
// ==========================================

model Incident {
  id                String    @id @default(uuid())
  tenantId          String
  companyId         String
  number            String
  title             String
  incidentType      String    @default("NEAR_MISS")
  severity          String    @default("LOW")
  status            String    @default("REPORTED")
  reportedBy        String
  reportedAt        DateTime  @default(now())
  occurredAt        DateTime
  location          String?
  description       String
  injuries          String?
  witnesses         String?
  rootCause         String?
  preventiveActions String?
  closedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("incidents")
}

model RiskAssessment {
  id         String   @id @default(uuid())
  tenantId   String
  companyId  String
  number     String
  title      String
  assessedBy String
  assessedAt DateTime @default(now())
  reviewDue  DateTime
  status     String   @default("DRAFT")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company      @relation(fields: [companyId], references: [id])
  hazards RiskHazard[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("risk_assessments")
}

model RiskHazard {
  id                 String  @id @default(uuid())
  riskId             String
  hazard             String
  category           String  @default("GENERAL")
  likelihood         Int     @default(3)
  severity           Int     @default(3)
  riskScore          Int     @default(9)
  controls           String?
  residualLikelihood Int?
  residualSeverity   Int?
  residualScore      Int?

  assessment RiskAssessment @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@map("risk_hazards")
}

model PermitToWork {
  id          String    @id @default(uuid())
  tenantId    String
  companyId   String
  number      String
  permitType  String    @default("GENERAL")
  title       String
  location    String?
  requestedBy String
  approvedBy  String?
  status      String    @default("PENDING")
  validFrom   DateTime
  validTo     DateTime
  conditions  String?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("permits_to_work")
}

// ==========================================
// PROJECT MANAGEMENT
// ==========================================

model Project {
  id          String    @id @default(uuid())
  tenantId    String
  companyId   String
  code        String
  name        String
  description String?
  status      String    @default("PLANNING")
  priority    String    @default("NORMAL")
  managerId   String
  customerId  String?
  budget      Decimal?  @db.Decimal(19, 4)
  actualCost  Decimal   @default(0) @db.Decimal(19, 4)
  startDate   DateTime
  endDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company    Company          @relation(fields: [companyId], references: [id])
  tasks      WBSTask[]
  timesheets Timesheet[]
  billings   ProjectBilling[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("projects")
}

model WBSTask {
  id             String    @id @default(uuid())
  tenantId       String
  companyId      String
  projectId      String
  parentId       String?
  code           String
  title          String
  description    String?
  status         String    @default("TODO")
  priority       String    @default("NORMAL")
  assigneeId     String?
  estimatedHours Decimal?  @db.Decimal(8, 2)
  actualHours    Decimal   @default(0) @db.Decimal(8, 2)
  plannedStart   DateTime?
  plannedEnd     DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?
  progress       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent     WBSTask?    @relation("WBSHierarchy", fields: [parentId], references: [id])
  children   WBSTask[]   @relation("WBSHierarchy")
  timesheets Timesheet[]

  @@index([tenantId, companyId, projectId])
  @@map("wbs_tasks")
}

model Timesheet {
  id          String    @id @default(uuid())
  tenantId    String
  companyId   String
  employeeId  String?
  projectId   String
  taskId      String?
  date        DateTime  @db.Date
  hours       Decimal   @db.Decimal(5, 2)
  description String?
  billable    Boolean   @default(true)
  status      String    @default("DRAFT")
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company  @relation(fields: [companyId], references: [id])
  project Project  @relation(fields: [projectId], references: [id])
  task    WBSTask? @relation(fields: [taskId], references: [id])

  @@index([tenantId, companyId, projectId])
  @@map("timesheets")
}

model ProjectBilling {
  id        String    @id @default(uuid())
  tenantId  String
  companyId String
  projectId String
  number    String
  billType  String    @default("MILESTONE")
  amount    Decimal   @db.Decimal(19, 4)
  status    String    @default("DRAFT")
  billedAt  DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  project Project @relation(fields: [projectId], references: [id])

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("project_billings")
}
