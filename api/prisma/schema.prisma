  jobType      String    @default("FULL_TIME")
  salaryMin    Decimal?  @db.Decimal(19, 4)
  salaryMax    Decimal?  @db.Decimal(19, 4)
  status       String    @default("DRAFT")
  postedAt     DateTime?
