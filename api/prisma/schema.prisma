  totalGross  Decimal   @default(0) @db.Decimal(19, 4)
  totalNet    Decimal   @default(0) @db.Decimal(19, 4)
  totalTax    Decimal   @default(0) @db.Decimal(19, 4)
  createdBy   String
  approvedBy  String?
  approvedAt  DateTime?
  postedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  payslips Payslip[]

  @@unique([tenantId, companyId, reference])
  @@index([tenantId, companyId])
  @@map("payroll_runs")
}

model Payslip {
  id              String   @id @default(uuid())
  tenantId        String
  companyId       String
  payrollRunId    String
  employeeId      String
  grossPay        Decimal  @default(0) @db.Decimal(19, 4)
  totalDeductions Decimal  @default(0) @db.Decimal(19, 4)
  taxAmount       Decimal  @default(0) @db.Decimal(19, 4)
  netPay          Decimal  @default(0) @db.Decimal(19, 4)
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company    Company       @relation(fields: [companyId], references: [id])
  payrollRun PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee      @relation(fields: [employeeId], references: [id])
  lines      PayslipLine[]

  @@unique([payrollRunId, employeeId])
  @@index([tenantId, companyId])
  @@map("payslips")
}

model PayslipLine {
  id          String  @id @default(uuid())
  payslipId   String
  type        String
  code        String
  description String
  amount      Decimal @db.Decimal(19, 4)
  sequence    Int

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@map("payslip_lines")
}

model JobPosting {
