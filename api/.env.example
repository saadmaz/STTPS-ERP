# Copy to .env for local development; never commit it.
# In Cloudflare these values are runtime secrets of the API container.
# Every variable is described in docs/CONFIGURATION.md.

# ── Firestore ──────────────────────────────────────────────────────────────
# Firebase Console -> Project Settings -> Service Accounts -> Generate new
# private key. FIREBASE_PRIVATE_KEY is one line with literal \n sequences.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080   # development and tests only

# ── Access tokens ──────────────────────────────────────────────────────────
# Required. The API will not start without at least 32 characters.
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=15m

# ── Server ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# ── Email (optional) ───────────────────────────────────────────────────────
# Without a key, notification email is logged instead of sent.
# RESEND_API_KEY=
# EMAIL_FROM="STTPS ERP <no-reply@sttps.co>"
