# Copy to .env and fill in before running locally or deploying.
# On the server this is uploaded manually (SFTP/File Manager), never via Git.

# ── Firestore (primary datastore — see DEPLOYMENT.md migration plan) ──────
# From Firebase Console -> Project Settings -> Service Accounts -> Generate
# new private key. FIREBASE_PRIVATE_KEY is stored here as a single-line
# string with literal \n sequences; the app un-escapes them at runtime.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# FIRESTORE_EMULATOR_HOST=      # dev/CI only — never set in production

# ── DATABASE_URL (inert — do not remove) ───────────────────────────────────
# Not actually connected to: PrismaModule is no longer imported in
# app.module.ts (the platform runs on Firestore, not PostgreSQL), so
# PrismaService.onModuleInit()'s $connect() never runs. Kept only so
# `prisma generate` (postinstall) succeeds and the not-yet-migrated feature
# modules' files still type-check against @prisma/client during Phase 2.
DATABASE_URL="postgresql://unused:unused@localhost:5432/unused"

# ── JWT (access token) ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-secure-random-string-min-32-chars"
JWT_EXPIRES_IN="15m"
# Refresh tokens are opaque random strings stored in Firestore (`sessions`
# collection, keyed by the token itself) — there is no JWT_REFRESH_SECRET.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS (must match the deployed web/admin origins exactly) ──────────────
FRONTEND_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3002"
