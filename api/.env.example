# Copy to .env and fill in before running locally or deploying.
# On the server this is uploaded manually (SFTP/File Manager), never via Git.

# ── Database ────────────────────────────────────────────────────────────────
# Local dev: Docker Postgres (see docker-compose.yml at the repo root)
# Production: your managed/Zircon PostgreSQL connection string
DATABASE_URL="postgresql://sttps:sttps_dev_password@localhost:5432/sttps?schema=public"

# ── JWT (access token) ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-secure-random-string-min-32-chars"
JWT_EXPIRES_IN="15m"
# Refresh tokens are opaque random strings stored in the database
# (see AuthService.refreshTokens) — there is no JWT_REFRESH_SECRET to set.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── CORS (must match the deployed web/admin origins exactly) ──────────────
FRONTEND_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3002"
