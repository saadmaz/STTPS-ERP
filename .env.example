# ─── Database ─────────────────────────────────────────────────────────────────
# Local dev: Docker PostgreSQL
# Production: Cloud SQL PostgreSQL connection string (use Cloud SQL Auth Proxy)
DATABASE_URL="postgresql://sttps:sttps_dev_password@localhost:5432/sttps?schema=public"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-secure-random-string-min-32-chars"
JWT_REFRESH_SECRET="change-me-to-another-secure-random-string-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── API ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local dev: Docker Redis
# Production: Google Cloud Memorystore Redis endpoint
REDIS_URL="redis://localhost:6379"

# ─── Google Cloud Storage (GCS) ───────────────────────────────────────────────
# Production: GCS bucket for file uploads, attachments, exports
# Set GOOGLE_APPLICATION_CREDENTIALS to a service account key file (local dev)
# or use Workload Identity Federation in GKE (production — no key file needed)
GCS_BUCKET_NAME="sttps-files-production"
GCS_PROJECT_ID="sttps-production"
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"  # local dev only

# ─── Email (SendGrid via GCP Marketplace) ─────────────────────────────────────
SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="noreply@sttps.live"
EMAIL_FROM_NAME="STTPS ERP"

# ─── Google Secret Manager (production) ───────────────────────────────────────
# In production, secrets above are stored in Google Secret Manager.
# Reference them as: projects/sttps-production/secrets/JWT_SECRET/versions/latest
# The app reads them via the Secret Manager client library at startup.
# GCP_PROJECT_ID="sttps-production"
