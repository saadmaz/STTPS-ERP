generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// PLATFORM — tenant registry
// ==========================================

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("starter")
  status    String   @default("active")
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenants")
}

// ==========================================
// IDENTITY & ACCESS
// ==========================================

model Company {
  id              String    @id @default(uuid())
  tenantId        String
  name            String
  code            String
  legalName       String?
  taxId           String?
  currency        String    @default("USD")
  timezone        String    @default("UTC")
  fiscalYearStart Int       @default(1)
  address         Json?
  logoUrl         String?
  parentId        String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  parent       Company?      @relation("CompanyHierarchy", fields: [parentId], references: [id])
  children     Company[]     @relation("CompanyHierarchy")
  companyUsers  CompanyUser[]
  roles         Role[]
  glAccounts    GlAccount[]
  glPeriods     GlPeriod[]
  glJournals    GlJournal[]
  vendors       Vendor[]
  customers     Customer[]
  bankAccounts          BankAccount[]
  fixedAssets           FixedAsset[]
  budgets               Budget[]
  itemCategories        ItemCategory[]
  items                 Item[]
  warehouses            Warehouse[]
  stockMovements        StockMovement[]
  stockCounts           StockCount[]
  purchaseRequisitions  PurchaseRequisition[]
  purchaseOrders        PurchaseOrder[]
  goodsReceipts         GoodsReceipt[]
  crmLeads              Lead[]
  crmAccounts           CrmAccount[]
  crmContacts           CrmContact[]
  opportunities         Opportunity[]
  crmActivities         Activity[]
  priceLists            PriceList[]
  salesQuotes           SalesQuote[]
  salesOrders           SalesOrder[]
  deliveries            Delivery[]
  billsOfMaterials      BillOfMaterials[]
  workCenters           WorkCenter[]
  routings              Routing[]
  productionOrders      ProductionOrder[]
  mrpPlans              MRPPlan[]
  departments           Department[]
  positions             Position[]
  employees             Employee[]
  leaveTypes            LeaveType[]
  leaveRequests         LeaveRequest[]
  payrollRuns           PayrollRun[]
  payslips              Payslip[]
  jobPostings           JobPosting[]
  jobApplications       JobApplication[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("companies")
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  email        String
  firstName    String
  lastName     String
  passwordHash String
  phone        String?
  avatar       String?
  isActive     Boolean   @default(true)
  isSuperAdmin Boolean   @default(false)
  mfaEnabled   Boolean   @default(false)
  mfaSecret    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  companyUsers CompanyUser[]
  sessions     Session[]
  auditLogs    AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model CompanyUser {
  id        String  @id @default(uuid())
  userId    String
  companyId String
  isDefault Boolean @default(false)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([userId, companyId])
  @@map("company_users")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  companyId   String?
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company         Company?         @relation(fields: [companyId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([tenantId])
  @@map("roles")
}

model UserRole {
  id            String   @id @default(uuid())
  companyUserId String
  roleId        String
  grantedAt     DateTime @default(now())
  grantedBy     String?

  companyUser CompanyUser @relation(fields: [companyUserId], references: [id], onDelete: Cascade)
  role        Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([companyUserId, roleId])
  @@map("user_roles")
}

model Permission {
  id     String @id @default(uuid())
  code   String @unique
  name   String
  module String
  action String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  companyId String?
  userId    String?
  module    String
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ==========================================
// FINANCE — GENERAL LEDGER
// ==========================================

model GlAccount {
  id          String  @id @default(uuid())
  tenantId    String
  companyId   String
  code        String
  name        String
  type        String
  subtype     String?
  currency    String  @default("USD")
  parentId    String?
  isActive    Boolean @default(true)
  isPosting   Boolean @default(true)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id])
  parent       GlAccount?    @relation("GlAccountTree", fields: [parentId], references: [id])
  children     GlAccount[]   @relation("GlAccountTree")
  journalLines GlJournalLine[]
  apLines      ApInvoiceLine[]
  arLines      ArInvoiceLine[]
  bankAccounts BankAccount[]
  budgetLines  BudgetLine[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("gl_accounts")
}

model GlPeriod {
  id         String   @id @default(uuid())
  tenantId   String
  companyId  String
  fiscalYear Int
  period     Int
  name       String
  startDate  DateTime
  endDate    DateTime
  status     String   @default("OPEN")

  company  Company     @relation(fields: [companyId], references: [id])
  journals GlJournal[]

  @@unique([tenantId, companyId, fiscalYear, period])
  @@index([tenantId, companyId])
  @@map("gl_periods")
}

model GlJournal {
  id          String    @id @default(uuid())
  tenantId    String
  companyId   String
  periodId    String
  number      String
  date        DateTime
  description String?
  reference   String?
  type        String    @default("MANUAL")
  status      String    @default("DRAFT")
  currency    String    @default("USD")
  totalDebit  Decimal   @default(0) @db.Decimal(19, 4)
  totalCredit Decimal   @default(0) @db.Decimal(19, 4)
  createdBy   String
  postedBy    String?
  postedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company         @relation(fields: [companyId], references: [id])
  period  GlPeriod        @relation(fields: [periodId], references: [id])
  lines   GlJournalLine[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId, date])
  @@map("gl_journals")
}

model GlJournalLine {
  id           String  @id @default(uuid())
  journalId    String
  accountId    String
  lineNumber   Int
  description  String?
  debit        Decimal @default(0) @db.Decimal(19, 4)
  credit       Decimal @default(0) @db.Decimal(19, 4)
  currency     String  @default("USD")
  exchangeRate Decimal @default(1) @db.Decimal(19, 6)

  journal GlJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account GlAccount @relation(fields: [accountId], references: [id])

  @@map("gl_journal_lines")
}

// ==========================================
// ACCOUNTS PAYABLE
// ==========================================

model Vendor {
  id           String   @id @default(uuid())
  tenantId     String
  companyId    String
  code         String
  name         String
  legalName    String?
  taxId        String?
  email        String?
  phone        String?
  currency     String   @default("USD")
  paymentTerms Int      @default(30)
  address      Json?
  bankDetails  Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  invoices       ApInvoice[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("vendors")
}

model ApInvoice {
  id           String    @id @default(uuid())
  tenantId     String
  companyId    String
  vendorId     String
  number       String
  vendorRef    String?
  date         DateTime
  dueDate      DateTime
  currency     String    @default("USD")
  exchangeRate Decimal   @default(1) @db.Decimal(19, 6)
  subtotal     Decimal   @default(0) @db.Decimal(19, 4)
  taxAmount    Decimal   @default(0) @db.Decimal(19, 4)
  total        Decimal   @default(0) @db.Decimal(19, 4)
  paid         Decimal   @default(0) @db.Decimal(19, 4)
  balance      Decimal   @default(0) @db.Decimal(19, 4)
  status       String    @default("DRAFT")
  notes        String?
  createdBy    String
  approvedBy   String?
  approvedAt   DateTime?
  postedBy     String?
  postedAt     DateTime?
  poId         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  vendor Vendor          @relation(fields: [vendorId], references: [id])
  lines  ApInvoiceLine[]
  po     PurchaseOrder?  @relation(fields: [poId], references: [id])

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("ap_invoices")
}

model ApInvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  accountId   String
  lineNumber  Int
  description String
  quantity    Decimal @default(1) @db.Decimal(19, 4)
  unitPrice   Decimal @default(0) @db.Decimal(19, 4)
  amount      Decimal @default(0) @db.Decimal(19, 4)
  taxCode     String?
  taxAmount   Decimal @default(0) @db.Decimal(19, 4)

  invoice ApInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  account GlAccount @relation(fields: [accountId], references: [id])

  @@map("ap_invoice_lines")
}

// ==========================================
// ACCOUNTS RECEIVABLE
// ==========================================

model Customer {
  id           String   @id @default(uuid())
  tenantId     String
  companyId    String
  code         String
  name         String
  legalName    String?
  taxId        String?
  email        String?
  phone        String?
  currency     String   @default("USD")
  paymentTerms Int      @default(30)
  creditLimit  Decimal  @default(0) @db.Decimal(19, 4)
  address      Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  invoices    ArInvoice[]
  salesQuotes SalesQuote[]
  salesOrders SalesOrder[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("customers")
}

model ArInvoice {
  id           String    @id @default(uuid())
  tenantId     String
  companyId    String
  customerId   String
  number       String
  date         DateTime
  dueDate      DateTime
  currency     String    @default("USD")
  exchangeRate Decimal   @default(1) @db.Decimal(19, 6)
  subtotal     Decimal   @default(0) @db.Decimal(19, 4)
  taxAmount    Decimal   @default(0) @db.Decimal(19, 4)
  total        Decimal   @default(0) @db.Decimal(19, 4)
  paid         Decimal   @default(0) @db.Decimal(19, 4)
  balance      Decimal   @default(0) @db.Decimal(19, 4)
  status       String    @default("DRAFT")
  notes        String?
  createdBy    String
  postedBy     String?
  postedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id])
  lines    ArInvoiceLine[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("ar_invoices")
}

model ArInvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  accountId   String
  lineNumber  Int
  description String
  quantity    Decimal @default(1) @db.Decimal(19, 4)
  unitPrice   Decimal @default(0) @db.Decimal(19, 4)
  amount      Decimal @default(0) @db.Decimal(19, 4)
  taxCode     String?
  taxAmount   Decimal @default(0) @db.Decimal(19, 4)

  invoice ArInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  account GlAccount @relation(fields: [accountId], references: [id])

  @@map("ar_invoice_lines")
}

// ==========================================
// BANK & CASH
// ==========================================

model BankAccount {
  id            String   @id @default(uuid())
  tenantId      String
  companyId     String
  code          String
  name          String
  bankName      String?
  accountNumber String?
  currency      String   @default("USD")
  glAccountId   String?
  balance       Decimal  @default(0) @db.Decimal(19, 4)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company    Company        @relation(fields: [companyId], references: [id])
  glAccount  GlAccount?     @relation(fields: [glAccountId], references: [id])
  statements BankStatement[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("bank_accounts")
}

model BankStatement {
  id            String   @id @default(uuid())
  tenantId      String
  companyId     String
  bankAccountId String
  date          DateTime
  description   String?
  debit         Decimal  @default(0) @db.Decimal(19, 4)
  credit        Decimal  @default(0) @db.Decimal(19, 4)
  balance       Decimal  @default(0) @db.Decimal(19, 4)
  reference     String?
  isReconciled  Boolean  @default(false)
  createdAt     DateTime @default(now())

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([tenantId, companyId])
  @@map("bank_statements")
}

// ==========================================
// FIXED ASSETS
// ==========================================

model FixedAsset {
  id                   String    @id @default(uuid())
  tenantId             String
  companyId            String
  code                 String
  name                 String
  category             String
  acquisitionDate      DateTime
  acquisitionCost      Decimal   @db.Decimal(19, 4)
  depreciationMethod   String    @default("STRAIGHT_LINE")
  usefulLifeMonths     Int       @default(60)
  salvageValue         Decimal   @default(0) @db.Decimal(19, 4)
  accumulatedDepr      Decimal   @default(0) @db.Decimal(19, 4)
  netBookValue         Decimal   @default(0) @db.Decimal(19, 4)
  status               String    @default("ACTIVE")
  assetAccountId       String?
  depreciationAcctId   String?
  accumDeprAcctId      String?
  disposalDate         DateTime?
  disposalAmount       Decimal?  @db.Decimal(19, 4)
  notes                String?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("fixed_assets")
}

// ==========================================
// BUDGETS
// ==========================================

model Budget {
  id          String    @id @default(uuid())
  tenantId    String
  companyId   String
  name        String
  fiscalYear  Int
  status      String    @default("DRAFT")
  description String?
  notes       String?
  createdBy   String
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company      @relation(fields: [companyId], references: [id])
  lines   BudgetLine[]

  @@index([tenantId, companyId])
  @@map("budgets")
}

model BudgetLine {
  id        String  @id @default(uuid())
  budgetId  String
  accountId String
  period    Int
  amount    Decimal @default(0) @db.Decimal(19, 4)
  notes     String?

  budget  Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account GlAccount @relation(fields: [accountId], references: [id])

  @@unique([budgetId, accountId, period])
  @@map("budget_lines")
}

// ==========================================
// INVENTORY
// ==========================================

model ItemCategory {
  id          String   @id @default(uuid())
  tenantId    String
  companyId   String
  code        String
  name        String
  description String?
  parentId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company        @relation(fields: [companyId], references: [id])
  parent   ItemCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ItemCategory[] @relation("CategoryHierarchy")
  items    Item[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("item_categories")
}

model Item {
  id                  String   @id @default(uuid())
  tenantId            String
  companyId           String
  categoryId          String?
  code                String
  name                String
  description         String?
  uom                 String   @default("EA")
  itemType            String   @default("PRODUCT")
  trackInventory      Boolean  @default(true)
  reorderPoint        Decimal  @default(0) @db.Decimal(19, 4)
  reorderQty          Decimal  @default(0) @db.Decimal(19, 4)
  standardCost        Decimal  @default(0) @db.Decimal(19, 4)
  listPrice           Decimal  @default(0) @db.Decimal(19, 4)
  inventoryAccountId  String?
  cogsAccountId       String?
  salesAccountId      String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company         Company       @relation(fields: [companyId], references: [id])
  category        ItemCategory? @relation(fields: [categoryId], references: [id])
  stockLevels     StockLevel[]
  stockMovements  StockMovement[]
  prLines         PRLine[]
  poLines         POLine[]
  grnLines        GoodsReceiptLine[]
  stockCountLines StockCountLine[]
  priceListItems      PriceListItem[]
  quoteLines          QuoteLine[]
  soLines             SOLine[]
  deliveryLines       DeliveryLine[]
  bomAsFinishedGood   BillOfMaterials[]           @relation("BOMFinishedGood")
  bomComponents       BOMLine[]                   @relation("BOMComponent")
  productionOrders    ProductionOrder[]            @relation("ProductionOrderItem")
  productionComponents ProductionComponent[]       @relation("ProductionComponent")
  plannedOrders       PlannedOrder[]               @relation("PlannedOrderItem")

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("items")
}

model Warehouse {
  id          String   @id @default(uuid())
  tenantId    String
  companyId   String
  code        String
  name        String
  address     Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company          Company           @relation(fields: [companyId], references: [id])
  locations        StorageLocation[]
  stockLevels      StockLevel[]
  stockMovements   StockMovement[]
  stockCounts      StockCount[]
  deliveries       Delivery[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("warehouses")
}

model StorageLocation {
  id          String  @id @default(uuid())
  warehouseId String
  code        String
  name        String
  zone        String?
  aisle       String?
  bin         String?

  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockLevels  StockLevel[]

  @@unique([warehouseId, code])
  @@map("storage_locations")
}

model StockLevel {
  id          String  @id @default(uuid())
  tenantId    String
  companyId   String
  itemId      String
  warehouseId String
  locationId  String?
  qty         Decimal @default(0) @db.Decimal(19, 4)
  reservedQty Decimal @default(0) @db.Decimal(19, 4)
  avgCost     Decimal @default(0) @db.Decimal(19, 4)

  item      Item             @relation(fields: [itemId], references: [id])
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  location  StorageLocation? @relation(fields: [locationId], references: [id])

  @@unique([tenantId, companyId, itemId, warehouseId])
  @@index([tenantId, companyId])
  @@map("stock_levels")
}

model StockMovement {
  id            String   @id @default(uuid())
  tenantId      String
  companyId     String
  itemId        String
  warehouseId   String
  movementType  String
  reference     String?
  qty           Decimal  @db.Decimal(19, 4)
  unitCost      Decimal  @default(0) @db.Decimal(19, 4)
  totalCost     Decimal  @default(0) @db.Decimal(19, 4)
  qtyBefore     Decimal  @default(0) @db.Decimal(19, 4)
  qtyAfter      Decimal  @default(0) @db.Decimal(19, 4)
  notes         String?
  createdBy     String
  createdAt     DateTime @default(now())

  company   Company   @relation(fields: [companyId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, companyId])
  @@index([tenantId, companyId, itemId])
  @@map("stock_movements")
}

model StockCount {
  id          String    @id @default(uuid())
  tenantId    String
  companyId   String
  warehouseId String
  reference   String
  countDate   DateTime
  status      String    @default("DRAFT")
  notes       String?
  createdBy   String
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company   Company          @relation(fields: [companyId], references: [id])
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  lines     StockCountLine[]

  @@index([tenantId, companyId])
  @@map("stock_counts")
}

model StockCountLine {
  id           String  @id @default(uuid())
  stockCountId String
  itemId       String
  systemQty    Decimal @default(0) @db.Decimal(19, 4)
  countedQty   Decimal @default(0) @db.Decimal(19, 4)
  variance     Decimal @default(0) @db.Decimal(19, 4)
  notes        String?

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  item       Item       @relation(fields: [itemId], references: [id])

  @@map("stock_count_lines")
}

// ==========================================
// PROCUREMENT
// ==========================================

model PurchaseRequisition {
  id           String    @id @default(uuid())
  tenantId     String
  companyId    String
  number       String
  requestedBy  String
  requestDate  DateTime
  requiredDate DateTime?
  status       String    @default("DRAFT")
  notes        String?
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company        Company        @relation(fields: [companyId], references: [id])
  lines          PRLine[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("purchase_requisitions")
}

model PRLine {
  id          String   @id @default(uuid())
  prId        String
  itemId      String
  description String?
  qty         Decimal  @db.Decimal(19, 4)
  uom         String   @default("EA")
  estUnitCost Decimal  @default(0) @db.Decimal(19, 4)
  estTotal    Decimal  @default(0) @db.Decimal(19, 4)
  lineNumber  Int

  pr   PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
  item Item               @relation(fields: [itemId], references: [id])

  @@map("pr_lines")
}

model PurchaseOrder {
  id           String    @id @default(uuid())
  tenantId     String
  companyId    String
  vendorId     String
  prId         String?
  number       String
  orderDate    DateTime
  expectedDate DateTime?
  currency     String    @default("USD")
  exchangeRate Decimal   @default(1) @db.Decimal(19, 6)
  subtotal     Decimal   @default(0) @db.Decimal(19, 4)
  taxAmount    Decimal   @default(0) @db.Decimal(19, 4)
  total        Decimal   @default(0) @db.Decimal(19, 4)
  status       String    @default("DRAFT")
  notes        String?
  createdBy    String
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company              @relation(fields: [companyId], references: [id])
  vendor       Vendor               @relation(fields: [vendorId], references: [id])
  pr           PurchaseRequisition? @relation(fields: [prId], references: [id])
  lines        POLine[]
  goodsReceipts GoodsReceipt[]
  apInvoices   ApInvoice[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("purchase_orders")
}

model POLine {
  id          String  @id @default(uuid())
  poId        String
  itemId      String
  description String?
  qty         Decimal @db.Decimal(19, 4)
  qtyReceived Decimal @default(0) @db.Decimal(19, 4)
  qtyInvoiced Decimal @default(0) @db.Decimal(19, 4)
  uom         String  @default("EA")
  unitPrice   Decimal @default(0) @db.Decimal(19, 4)
  taxCode     String?
  taxAmount   Decimal @default(0) @db.Decimal(19, 4)
  lineTotal   Decimal @default(0) @db.Decimal(19, 4)
  lineNumber  Int

  po   PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  item Item          @relation(fields: [itemId], references: [id])

  @@map("po_lines")
}

model GoodsReceipt {
  id            String    @id @default(uuid())
  tenantId      String
  companyId     String
  poId          String
  warehouseId   String
  number        String
  receiptDate   DateTime
  status        String    @default("DRAFT")
  notes         String?
  createdBy     String
  postedBy      String?
  postedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company   Company            @relation(fields: [companyId], references: [id])
  po        PurchaseOrder      @relation(fields: [poId], references: [id])
  lines     GoodsReceiptLine[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id         String  @id @default(uuid())
  grnId      String
  itemId     String
  poLineId   String?
  qty        Decimal @db.Decimal(19, 4)
  unitCost   Decimal @default(0) @db.Decimal(19, 4)
  totalCost  Decimal @default(0) @db.Decimal(19, 4)
  locationId String?
  lineNumber Int

  grn  GoodsReceipt @relation(fields: [grnId], references: [id], onDelete: Cascade)
  item Item         @relation(fields: [itemId], references: [id])

  @@map("goods_receipt_lines")
}

// ==========================================
// CRM
// ==========================================

model Lead {
  id          String    @id @default(uuid())
  tenantId    String
  companyId   String
  firstName   String
  lastName    String
  email       String?
  phone       String?
  company     String?
  title       String?
  source      String?
  status      String    @default("NEW")
  score       Int       @default(0)
  ownerId     String?
  notes       String?
  convertedAt DateTime?
  contactId   String?
  accountId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  companyRel   Company      @relation(fields: [companyId], references: [id])
  activities   Activity[]

  @@index([tenantId, companyId])
  @@map("crm_leads")
}

model CrmAccount {
  id          String   @id @default(uuid())
  tenantId    String
  companyId   String
  name        String
  industry    String?
  website     String?
  phone       String?
  email       String?
  address     Json?
  ownerId     String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyRel   Company        @relation(fields: [companyId], references: [id])
  contacts     CrmContact[]
  opportunities Opportunity[]
  activities   Activity[]

  @@index([tenantId, companyId])
  @@map("crm_accounts")
}

model CrmContact {
  id         String   @id @default(uuid())
  tenantId   String
  companyId  String
  accountId  String?
  firstName  String
  lastName   String
  email      String?
  phone      String?
  title      String?
  ownerId    String?
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  companyRel    Company      @relation(fields: [companyId], references: [id])
  account       CrmAccount?  @relation(fields: [accountId], references: [id])
  opportunities Opportunity[]
  activities    Activity[]

  @@index([tenantId, companyId])
  @@map("crm_contacts")
}

model Opportunity {
  id          String    @id @default(uuid())
  tenantId    String
  companyId   String
  accountId   String?
  contactId   String?
  name        String
  stage       String    @default("PROSPECTING")
  amount      Decimal   @default(0) @db.Decimal(19, 4)
  probability Int       @default(0)
  closeDate   DateTime?
  ownerId     String?
  source      String?
  notes       String?
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  companyRel Company     @relation(fields: [companyId], references: [id])
  account    CrmAccount? @relation(fields: [accountId], references: [id])
  contact    CrmContact? @relation(fields: [contactId], references: [id])
  activities Activity[]
  quotes     SalesQuote[]

  @@index([tenantId, companyId])
  @@map("opportunities")
}

model Activity {
  id             String    @id @default(uuid())
  tenantId       String
  companyId      String
  type           String
  subject        String
  description    String?
  status         String    @default("PLANNED")
  dueDate        DateTime?
  completedAt    DateTime?
  ownerId        String?
  leadId         String?
  accountId      String?
  contactId      String?
  opportunityId  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  companyRel   Company      @relation(fields: [companyId], references: [id])
  lead         Lead?        @relation(fields: [leadId], references: [id])
  account      CrmAccount?  @relation(fields: [accountId], references: [id])
  contact      CrmContact?  @relation(fields: [contactId], references: [id])
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id])

  @@index([tenantId, companyId])
  @@map("crm_activities")
}

// ==========================================
// SALES
// ==========================================

model PriceList {
  id          String   @id @default(uuid())
  tenantId    String
  companyId   String
  code        String
  name        String
  currency    String   @default("USD")
  isDefault   Boolean  @default(false)
  validFrom   DateTime?
  validTo     DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyRel Company         @relation(fields: [companyId], references: [id])
  items      PriceListItem[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("price_lists")
}

model PriceListItem {
  id          String  @id @default(uuid())
  priceListId String
  itemId      String
  unitPrice   Decimal @db.Decimal(19, 4)
  minQty      Decimal @default(0) @db.Decimal(19, 4)
  uom         String  @default("EA")

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id])

  @@unique([priceListId, itemId])
  @@map("price_list_items")
}

model SalesQuote {
  id             String    @id @default(uuid())
  tenantId       String
  companyId      String
  customerId     String
  opportunityId  String?
  number         String
  quoteDate      DateTime
  validUntil     DateTime?
  currency       String    @default("USD")
  exchangeRate   Decimal   @default(1) @db.Decimal(19, 6)
  subtotal       Decimal   @default(0) @db.Decimal(19, 4)
  discountAmount Decimal   @default(0) @db.Decimal(19, 4)
  taxAmount      Decimal   @default(0) @db.Decimal(19, 4)
  total          Decimal   @default(0) @db.Decimal(19, 4)
  status         String    @default("DRAFT")
  notes          String?
  createdBy      String
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  companyRel  Company      @relation(fields: [companyId], references: [id])
  customer    Customer     @relation(fields: [customerId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  lines       QuoteLine[]
  salesOrders SalesOrder[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("sales_quotes")
}

model QuoteLine {
  id          String  @id @default(uuid())
  quoteId     String
  itemId      String
  description String?
  qty         Decimal @db.Decimal(19, 4)
  uom         String  @default("EA")
  unitPrice   Decimal @default(0) @db.Decimal(19, 4)
  discount    Decimal @default(0) @db.Decimal(19, 4)
  taxCode     String?
  taxAmount   Decimal @default(0) @db.Decimal(19, 4)
  lineTotal   Decimal @default(0) @db.Decimal(19, 4)
  lineNumber  Int

  quote SalesQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  item  Item       @relation(fields: [itemId], references: [id])

  @@map("quote_lines")
}

model SalesOrder {
  id             String    @id @default(uuid())
  tenantId       String
  companyId      String
  customerId     String
  quoteId        String?
  number         String
  orderDate      DateTime
  requestedDate  DateTime?
  currency       String    @default("USD")
  exchangeRate   Decimal   @default(1) @db.Decimal(19, 6)
  subtotal       Decimal   @default(0) @db.Decimal(19, 4)
  discountAmount Decimal   @default(0) @db.Decimal(19, 4)
  taxAmount      Decimal   @default(0) @db.Decimal(19, 4)
  total          Decimal   @default(0) @db.Decimal(19, 4)
  status         String    @default("DRAFT")
  notes          String?
  createdBy      String
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  companyRel Company     @relation(fields: [companyId], references: [id])
  customer   Customer    @relation(fields: [customerId], references: [id])
  quote      SalesQuote? @relation(fields: [quoteId], references: [id])
  lines      SOLine[]
  deliveries Delivery[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("sales_orders")
}

model SOLine {
  id           String  @id @default(uuid())
  soId         String
  itemId       String
  description  String?
  qty          Decimal @db.Decimal(19, 4)
  qtyDelivered Decimal @default(0) @db.Decimal(19, 4)
  qtyInvoiced  Decimal @default(0) @db.Decimal(19, 4)
  uom          String  @default("EA")
  unitPrice    Decimal @default(0) @db.Decimal(19, 4)
  discount     Decimal @default(0) @db.Decimal(19, 4)
  taxCode      String?
  taxAmount    Decimal @default(0) @db.Decimal(19, 4)
  lineTotal    Decimal @default(0) @db.Decimal(19, 4)
  lineNumber   Int

  so   SalesOrder @relation(fields: [soId], references: [id], onDelete: Cascade)
  item Item       @relation(fields: [itemId], references: [id])

  @@map("so_lines")
}

model Delivery {
  id            String    @id @default(uuid())
  tenantId      String
  companyId     String
  soId          String
  warehouseId   String
  number        String
  deliveryDate  DateTime
  status        String    @default("DRAFT")
  notes         String?
  createdBy     String
  postedBy      String?
  postedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  companyRel Company        @relation(fields: [companyId], references: [id])
  so         SalesOrder     @relation(fields: [soId], references: [id])
  warehouse  Warehouse      @relation(fields: [warehouseId], references: [id])
  lines      DeliveryLine[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("deliveries")
}

model DeliveryLine {
  id           String  @id @default(uuid())
  deliveryId   String
  itemId       String
  soLineId     String?
  qty          Decimal @db.Decimal(19, 4)
  uom          String  @default("EA")
  locationId   String?
  lineNumber   Int

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id])

  @@map("delivery_lines")
}

// ==========================================
// MANUFACTURING
// ==========================================

model BillOfMaterials {
  id          String    @id @default(uuid())
  tenantId    String
  companyId   String
  itemId      String
  code        String
  version     String    @default("1")
  description String?
  baseQty     Decimal   @default(1) @db.Decimal(19, 4)
  uom         String    @default("EA")
  status      String    @default("DRAFT")
  isActive    Boolean   @default(true)
  validFrom   DateTime?
  validTo     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company          Company          @relation(fields: [companyId], references: [id])
  item             Item             @relation("BOMFinishedGood", fields: [itemId], references: [id])
  lines            BOMLine[]
  productionOrders ProductionOrder[]

  @@unique([tenantId, companyId, itemId, version])
  @@index([tenantId, companyId])
  @@map("bill_of_materials")
}

model BOMLine {
  id          String  @id @default(uuid())
  bomId       String
  itemId      String
  lineNumber  Int
  description String?
  qty         Decimal @db.Decimal(19, 4)
  uom         String  @default("EA")
  scrapPct    Decimal @default(0) @db.Decimal(5, 4)
  isPhantom   Boolean @default(false)

  bom  BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  item Item            @relation("BOMComponent", fields: [itemId], references: [id])

  @@map("bom_lines")
}

model WorkCenter {
  id          String   @id @default(uuid())
  tenantId    String
  companyId   String
  code        String
  name        String
  description String?
  type        String   @default("MACHINE")
  capacity    Decimal  @default(1) @db.Decimal(19, 4)
  efficiency  Decimal  @default(1) @db.Decimal(5, 4)
  costRate    Decimal  @default(0) @db.Decimal(19, 4)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company    Company            @relation(fields: [companyId], references: [id])
  operations RoutingOperation[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("work_centers")
}

model Routing {
  id          String   @id @default(uuid())
  tenantId    String
  companyId   String
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company    Company            @relation(fields: [companyId], references: [id])
  operations RoutingOperation[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("routings")
}

model RoutingOperation {
  id           String  @id @default(uuid())
  routingId    String
  workCenterId String?
  sequence     Int
  code         String
  description  String?
  setupTime    Decimal @default(0) @db.Decimal(10, 2)
  runTime      Decimal @default(0) @db.Decimal(10, 2)
  queueTime    Decimal @default(0) @db.Decimal(10, 2)
  uom          String  @default("MIN")

  routing    Routing     @relation(fields: [routingId], references: [id], onDelete: Cascade)
  workCenter WorkCenter? @relation(fields: [workCenterId], references: [id])

  @@map("routing_operations")
}

model ProductionOrder {
  id           String    @id @default(uuid())
  tenantId     String
  companyId    String
  itemId       String
  bomId        String?
  number       String
  description  String?
  plannedQty   Decimal   @db.Decimal(19, 4)
  producedQty  Decimal   @default(0) @db.Decimal(19, 4)
  scrapQty     Decimal   @default(0) @db.Decimal(19, 4)
  uom          String    @default("EA")
  status       String    @default("DRAFT")
  priority     Int       @default(5)
  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?
  notes        String?
  createdBy    String
  releasedBy   String?
  releasedAt   DateTime?
  closedBy     String?
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company    Company           @relation(fields: [companyId], references: [id])
  item       Item              @relation("ProductionOrderItem", fields: [itemId], references: [id])
  bom        BillOfMaterials?  @relation(fields: [bomId], references: [id])
  components ProductionComponent[]
  operations ProductionOperation[]

  @@unique([tenantId, companyId, number])
  @@index([tenantId, companyId])
  @@map("production_orders")
}

model ProductionComponent {
  id          String  @id @default(uuid())
  orderId     String
  itemId      String
  description String?
  requiredQty Decimal @db.Decimal(19, 4)
  issuedQty   Decimal @default(0) @db.Decimal(19, 4)
  uom         String  @default("EA")
  lineNumber  Int

  order ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  Item            @relation("ProductionComponent", fields: [itemId], references: [id])

  @@map("production_components")
}

model ProductionOperation {
  id           String    @id @default(uuid())
  orderId      String
  workCenterId String?
  sequence     Int
  code         String
  description  String?
  setupTime    Decimal   @default(0) @db.Decimal(10, 2)
  runTime      Decimal   @default(0) @db.Decimal(10, 2)
  status       String    @default("PENDING")
  startedAt    DateTime?
  completedAt  DateTime?

  order ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("production_operations")
}

model MRPPlan {
  id        String   @id @default(uuid())
  tenantId  String
  companyId String
  reference String
  runDate   DateTime
  planType  String   @default("FULL")
  status    String   @default("DRAFT")
  notes     String?
  createdBy String
  createdAt DateTime @default(now())

  company   Company        @relation(fields: [companyId], references: [id])
  proposals PlannedOrder[]

  @@index([tenantId, companyId])
  @@map("mrp_plans")
}

model PlannedOrder {
  id           String   @id @default(uuid())
  mrpPlanId    String
  tenantId     String
  companyId    String
  itemId       String
  orderType    String
  requiredQty  Decimal  @db.Decimal(19, 4)
  plannedStart DateTime
  plannedEnd   DateTime
  status       String   @default("PROPOSED")
  convertedId  String?

  mrpPlan MRPPlan @relation(fields: [mrpPlanId], references: [id], onDelete: Cascade)
  item    Item    @relation("PlannedOrderItem", fields: [itemId], references: [id])

  @@index([tenantId, companyId])
  @@map("planned_orders")
}
